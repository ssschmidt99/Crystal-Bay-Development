---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects.js';

const project = projects.find((p) => p.slug === 'reno-custom-lots');
const { details } = project;
const formName = `interest-${project.slug}`;
---

<Layout title={project.name} description={details.overview} accent={project.accent}>
  <div class="wrap breadcrumb">
    <a href="/">&larr; All Projects</a>
  </div>

  <div class="wrap coming-soon">
    <span class="eyebrow">{details.status} &middot; {project.location}</span>
    <h1>
      {project.headline.line1} <em>{project.headline.accentWord}</em>
    </h1>
    <p class="location">{details.address}</p>

    <div class="stat-cluster">
      {
        details.stats.map((stat) => (
          <div class="stat-chip">
            <span class="label">{stat.label}</span>
            <span class="value">{stat.value}</span>
          </div>
        ))
      }
    </div>

    <p class="lead">{details.lead}</p>
    <p class="description">{details.overview}</p>

    <figure class="feature-photo">
      <img src={details.aerial.src} alt={details.aerial.alt} loading="eager" />
    </figure>
  </div>

  <section class="section">
    <div class="wrap">
      <div class="section-heading">
        <span class="eyebrow">Available Homesites</span>
        <h2>Three homesites, one hilltop</h2>
      </div>
      <div class="lots-layout">
        <div class="lot-stack">
          {
            details.lots.map((lot) => (
              <div class="lot-card">
                <p class="lot-name">{lot.name}</p>
                <p class="lot-parcel">{lot.parcel}</p>
                <p class="lot-size">Lot: {lot.size}</p>
                <p class="lot-size">Conceptual home: {lot.home}</p>
              </div>
            ))
          }
        </div>
        <figure class="parcel-map">
          <img src={details.parcelMap.src} alt={details.parcelMap.alt} loading="lazy" />
          <figcaption>Refer to the parcel map specification document for more detail.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-heading">
        <span class="eyebrow">Conceptual Residences</span>
        <h2>Architecture drawn from the landscape</h2>
      </div>

      {
        details.residences.map((res) => (
          <article class="residence">
            <div class="residence-copy">
              <span class="eyebrow">{res.label}</span>
              <blockquote>{res.quote}</blockquote>
              <p class="cite">{res.architect}</p>
            </div>
            {res.images.length > 1 ? (
              <div class="gallery-grid">
                {res.images.map((image) => (
                  <a href={image.src} target="_blank" rel="noopener">
                    <img src={image.src} alt={image.alt} loading="lazy" />
                  </a>
                ))}
              </div>
            ) : (
              <figure class="residence-single">
                <img src={res.images[0].src} alt={res.images[0].alt} loading="lazy" />
              </figure>
            )}
          </article>
        ))
      }
      <p class="gallery-note">{details.residenceNote}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <div class="section-heading">
          <span class="eyebrow">The Setting</span>
          <h2>Southwest Reno's foothills</h2>
        </div>
        <ul class="highlights-list">
          {details.highlights.map((point) => <li>{point}</li>)}
        </ul>
      </div>
      <figure class="split-photo">
        <img src={details.renoView.src} alt={details.renoView.alt} loading="lazy" />
      </figure>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-heading">
        <span class="eyebrow">Architectural Drawings</span>
        <h2>The Lookout | A: schematic elevations & sections</h2>
      </div>
      <div class="drawing-grid">
        {
          details.drawings.map((drawing) => (
            <figure class="drawing-card">
              <img src={drawing.src} alt={drawing.alt} loading="lazy" />
              <figcaption>{drawing.caption}</figcaption>
            </figure>
          ))
        }
      </div>
      <p class="gallery-note">{details.drawingsNote}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap inquire-layout">
      <div class="register-panel">
        <h2>Inquire about this listing</h2>
        <p class="intro">Connect with the Crystal Bay team to learn more about these homesites.</p>

        <form name={formName} method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thank-you/">
          <input type="hidden" name="form-name" value={formName} />
          <input type="hidden" name="project" value={project.name} />
          <p class="honeypot-field">
            <label>Don't fill this out if you're human: <input name="bot-field" /></label>
          </p>

          <div class="form-row">
            <div class="form-field">
              <label for="first-name">First Name</label>
              <input id="first-name" name="first-name" type="text" required />
            </div>
            <div class="form-field">
              <label for="last-name">Last Name</label>
              <input id="last-name" name="last-name" type="text" required />
            </div>
          </div>

          <div class="form-row">
            <div class="form-field">
              <label for="email">Email Address</label>
              <input id="email" name="email" type="email" required />
            </div>
            <div class="form-field">
              <label for="phone">Phone Number</label>
              <input id="phone" name="phone" type="tel" />
            </div>
          </div>

          <div class="form-field">
            <label for="lot">Homesite of Interest</label>
            <select id="lot" name="lot-of-interest">
              <option value="Any">Any / Not sure yet</option>
              {details.lots.map((lot) => <option value={`${lot.name} (${lot.parcel})`}>{lot.name} ({lot.parcel})</option>)}
            </select>
          </div>

          <div class="form-field">
            <label for="message">Questions? (optional)</label>
            <textarea id="message" name="message" rows="3"></textarea>
          </div>

          <button class="btn btn-accent" type="submit">Send Inquiry</button>
          <p class="form-note">Your information is only shared with the Crystal Bay team. We never sell or distribute contact details.</p>
        </form>
      </div>

      <figure class="art-card">
        <img src={details.art.src} alt={details.art.alt} loading="lazy" />
      </figure>
    </div>

    <div class="wrap">
      <a class="back-home" href="/">&larr; Back to Crystal Bay Home</a>
    </div>
  </section>
</Layout>
