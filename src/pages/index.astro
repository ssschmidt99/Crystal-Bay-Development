---
import Layout from '../layouts/Layout.astro';
import { projects } from '../data/projects.js';
---

<Layout title="Home" description="Crystal Bay is a real estate development company. Explore our current projects.">
  <section class="hero" id="hero">
    <img
      class="hero-img"
      src="/images/water-street-cottages-exterior.jpg"
      alt="Rendering of Water Street Cottages, a Crystal Bay community"
      fetchpriority="high"
    />
    <div class="hero-scrim"></div>
    <div class="wrap hero-inner">
      <p class="hero-kicker" data-in style="--i: 0">Real estate development</p>
      <h1>
        <span class="line"><span style="--i: 1">Places built</span></span>
        <span class="line"><span style="--i: 2">for what's next.</span></span>
      </h1>
      <p class="hero-sub" data-in style="--i: 3">Storage, residential, and flex-space properties across the country.</p>
      <a class="btn btn-light" data-in style="--i: 4" href="#projects">Explore projects <span aria-hidden="true">&darr;</span></a>
    </div>
    <div class="hero-veil" aria-hidden="true"></div>
  </section>

  <section class="projects" id="projects">
    <div class="wrap">
      <div class="projects-head" data-reveal>
        <h2>Our projects</h2>
        <p>{projects.length} developments, from custom homesites to climate-controlled storage.</p>
      </div>

      <div class="tile-grid">
        {
          projects.map((project, i) => (
            <a
              class={`tile${project.tile ? '' : ' tile--plain'}`}
              style={`--tile-accent: ${project.accent}; --d: ${(i % 2) * 80}ms`}
              href={project.externalUrl ?? `/projects/${project.slug}/`}
              target={project.externalUrl ? '_blank' : undefined}
              rel={project.externalUrl ? 'noopener' : undefined}
              data-reveal
            >
              <div class="tile-media">
                {project.tile ? (
                  <img src={project.tile} alt="" loading={i < 2 ? 'eager' : 'lazy'} />
                ) : (
                  <span class="tile-plain-name">{project.headline.line1} <em>{project.headline.accentWord}</em></span>
                )}
                <span class="chip">{project.tag}</span>
              </div>
              <div class="tile-body">
                <div>
                  <h3>{project.name}</h3>
                  <p>{[project.location, project.category].filter(Boolean).join(' · ')}</p>
                </div>
                <span class="tile-stat">{project.stat}</span>
              </div>
              {project.externalUrl && <span class="tile-ext">Visit project site &nearr;</span>}
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="about">
    <div class="wrap about-inner" data-reveal>
      <h2>Thoughtfully built, with owners and operators in mind.</h2>
      <p>
        Crystal Bay develops attainable housing, custom homesites, flex space, and self storage. Register your interest
        on any project and we'll be in touch as details are released.
      </p>
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    var hero = document.getElementById('hero');
    if (!hero) return;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var img = hero.querySelector('.hero-img');

    // Scroll: photo drifts + zooms, text lifts + fades, photo dissolves into the white page.
    var inner = hero.querySelector('.hero-inner');
    var veil = hero.querySelector('.hero-veil');
    var ticking = false;
    function update() {
      ticking = false;
      var h = hero.offsetHeight;
      var y = Math.min(Math.max(window.scrollY, 0), h);
      var p = y / h;
      if (!reduce) {
        img.style.transform = 'translate3d(0,' + y * 0.28 + 'px,0) scale(' + (1 + p * 0.14) + ')';
        inner.style.transform = 'translate3d(0,' + -y * 0.14 + 'px,0)';
      }
      inner.style.opacity = Math.max(0, 1 - p * 1.5);
      veil.style.opacity = Math.min(1, Math.max(0, (p - 0.1) / 0.8));
    }
    window.addEventListener('scroll', function () {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>
