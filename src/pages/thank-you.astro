---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Thank You" description="Thanks for registering your interest with Crystal Bay.">
  <div class="wrap coming-soon">
    <span class="eyebrow">Thank You</span>
    <h1>We'll be <em>in touch</em></h1>
    <p class="description">
      Thanks for registering your interest. A member of the Crystal Bay team will reach out as soon as there's
      news to share.
    </p>
    <a class="back-home" href="/">&larr; Back to Crystal Bay Home</a>
  </div>
</Layout>
